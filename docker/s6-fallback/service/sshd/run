#!/bin/sh
# shellcheck shell=sh
# sshd — supervised in the non-PID-1 fallback path.
#
# Reuses the stock s6-rc.d script: host-key generation, authorized_keys
# seeding from SSH_PUBLIC_KEY and the port choice (SSH_PORT, default 2222)
# all behave as under s6-overlay. sshd keeps root, which the stock script
# handles.
#
# Output goes to a file (`s6 logs sshd`).
. /opt/hermes/docker/s6-fallback/lib.sh

LOG="$(log_dir)/sshd.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

exec sh /opt/hermes/docker/s6-rc.d/sshd/run >>"$LOG" 2>&1
