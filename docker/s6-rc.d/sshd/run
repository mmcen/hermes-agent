#!/command/with-contenv sh
# shellcheck shell=sh
# SSH server service. Controlled by SSH_ENABLED (default: disabled).
# Authorized keys come from SSH_PUBLIC_KEY env var or volume mount
# at /opt/data/.ssh/authorized_keys.

set -e

case "${SSH_ENABLED:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *)
        # Disabled — exit cleanly; finish script exits 125 (permanent failure)
        exit 0
        ;;
esac

# Regenerate host keys if missing (first boot)
if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
    ssh-keygen -A 2>/dev/null
fi

# Setup authorized_keys for both root and hermes users
if [ -n "${SSH_PUBLIC_KEY:-}" ]; then
    # Write to root's authorized_keys
    mkdir -p /root/.ssh
    echo "${SSH_PUBLIC_KEY}" > /root/.ssh/authorized_keys
    chmod 0700 /root/.ssh
    chmod 0600 /root/.ssh/authorized_keys

    # Write to hermes user's authorized_keys
    hermes_home="${HERMES_HOME:-/opt/data}"
    ssh_dir="${hermes_home}/.ssh"
    mkdir -p "${ssh_dir}"
    echo "${SSH_PUBLIC_KEY}" > "${ssh_dir}/authorized_keys"
    chmod 0700 "${ssh_dir}"
    chmod 0600 "${ssh_dir}/authorized_keys"
    chown -R hermes:hermes "${ssh_dir}" 2>/dev/null || true
fi

ssh_port="${SSH_PORT:-2222}"

echo "sshd: starting on port ${ssh_port}" >&2

exec /usr/sbin/sshd -D -e -p "${ssh_port}"